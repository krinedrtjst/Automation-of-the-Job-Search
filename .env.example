# Active person profile folder (e.g., karine_justino) — used when --person is not passed in the CLI
PERSON=karine_justino

# Active LLM Provider (openai | anthropic | gemini | grok | bedrock) — default: openai
LLM_PROVIDER=openai

# Maximum number of extra revisions to reach the target 8.5 rating (each consumes tokens; 0 just evaluates)
RESUME_MAX_REVISIONS=3

# Bedrock: Credentials must be in your AWS CLI profile, never in this file.
AWS_PROFILE=career-command-center
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-opus-20240229-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EXTRACTION_MODEL_ID=deepseek.v3.2
BEDROCK_MAX_TOKENS=16384

# ChatGPT
OPENAI_API_KEY=

# Claude
ANTHROPIC_API_KEY=

# Gemini (the code reads GOOGLE_API_KEY, not GEMINI_API_KEY)
GOOGLE_API_KEY=

# Grok (xAI)
XAI_API_KEY=